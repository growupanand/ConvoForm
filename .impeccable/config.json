{
  "buildPath": "code",
  "hook": {
    "enabled": true,
    "limits": {
      "maxFindings": 5,
      "maxChars": 8000
    }
  },
  "detector": {
    "ignoreRules": [
      "kicker-above-heading",
      "hero-eyebrow-chip"
    ],
    "ignoreFiles": [],
    "ignoreValues": [
      {
        "rule": "overused-font",
        "value": "inter",
        "reason": "Owner-approved brand type: DESIGN.md pins Inter for body text on the marketing site"
      }
    ],
    "ignoreRuleReasons": {
      "kicker-above-heading": "DESIGN.md section kicker pattern",
      "hero-eyebrow-chip": "DESIGN.md section kicker pattern"
    }
  }
}