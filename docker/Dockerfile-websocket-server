FROM oven/bun:latest AS base

ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NODE_ENV=${NODE_ENV}

WORKDIR /app

RUN bun add -g @pnpm/exe@latest-10
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN pnpm add -g turbo

# Add builder stage
FROM base AS builder
WORKDIR /app
COPY . .
RUN turbo prune websocket-server --docker

# Install dependencies
FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# Source is the runtime: Wrangler bundles the Worker on start.
COPY --from=builder /app/out/full/ .

FROM node:22-bookworm-slim AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=installer --chown=nextjs:nodejs /app /app

USER nextjs

EXPOSE 8787

# Durable Objects only run on Cloudflare or under `wrangler dev`.
# Compose sets NEXT_PUBLIC_APP_URL to the web service (http://web:3000).
CMD ["sh", "-c", "node apps/websocket-server/node_modules/wrangler/bin/wrangler.js dev --ip 0.0.0.0 --port 8787 --var NEXT_PUBLIC_APP_URL:${NEXT_PUBLIC_APP_URL:-http://web:3000}"]
